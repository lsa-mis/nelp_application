<h1 class="h4">NELP Payment Portal</h1>

<% if @home_message.present? %>
  <%= demote_action_text_h1(@home_message) %>
<% end %>

<% if current_program %>
  <div>
    <% if current_program_open? %>
      <%= simple_format(current_program.open_instructions) %>
    <% else %>
      <%= simple_format(current_program.close_instructions) %>
    <% end %>
  </div>
<% else %>
  <p>There are no active programs</p>
<% end %>
