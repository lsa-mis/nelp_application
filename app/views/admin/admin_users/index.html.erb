<% content_for :page_title, 'Admin Users' %>
<% content_for :page_actions do %>
  <%= link_to 'New Admin User', new_admin_admin_user_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<%= form_with url: admin_admin_users_path, method: :get, local: true, class: 'row g-2 align-items-end mb-3' do %>
  <div class="col-md-4">
    <%= label_tag :email, 'Email', class: 'form-label' %>
    <%= text_field_tag :email, params[:email], class: 'form-control' %>
  </div>
  <div class="col-md-2">
    <%= submit_tag 'Filter', class: 'btn btn-secondary' %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th>ID</th>
        <th>Email</th>
        <th>Created At</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @admin_users.each do |admin_user| %>
        <tr>
          <td><%= admin_user.id %></td>
          <td><%= admin_user.email %></td>
          <td><%= admin_user.created_at %></td>
          <td>
            <%= link_to 'View', admin_admin_user_path(admin_user), class: 'me-2' %>
            <%= link_to 'Edit', edit_admin_admin_user_path(admin_user), class: 'me-2' %>
            <%= link_to 'Delete', admin_admin_user_path(admin_user), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render 'admin/shared/pagination', pagy: @pagy %>
