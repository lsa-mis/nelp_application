<% content_for :page_title, 'Program Settings' %>
<% content_for :page_actions do %>
  <%= link_to 'New Program Setting', new_admin_program_setting_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th>Program Year</th>
        <th>Application Fee</th>
        <th>Program Fee</th>
        <th>Active</th>
        <th>Allow Payments</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @program_settings.each do |setting| %>
        <tr>
          <td><%= setting.program_year %></td>
          <td><%= setting.application_fee %></td>
          <td><%= setting.program_fee %></td>
          <td><%= setting.active? %></td>
          <td><%= setting.allow_payments? %></td>
          <td>
            <%= link_to 'View', admin_program_setting_path(setting), class: 'me-2' %>
            <%= link_to 'Edit', edit_admin_program_setting_path(setting), class: 'me-2' %>
            <%= link_to 'Delete', admin_program_setting_path(setting), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render 'admin/shared/pagination', pagy: @pagy %>
